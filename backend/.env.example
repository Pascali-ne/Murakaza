# --- Neon PostgreSQL ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="30d"

# --- CORS ---
FRONTEND_ORIGIN="https://murakaza.vercel.app"

# --- Rate limiting (Redis, e.g. Upstash) ---
REDIS_URL="redis://default:PASSWORD@HOST:PORT"

# --- Payments ---
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
FLUTTERWAVE_SECRET_KEY="FLWSECK-xxx"
FLUTTERWAVE_WEBHOOK_HASH="replace-with-verif-hash"
MOMO_API_KEY="replace-me"
MOMO_API_SECRET="replace-me"

# --- Server ---
PORT=8080
NODE_ENV="production"
