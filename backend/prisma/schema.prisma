// ============================================================
// Murakaza — Prisma Schema (Neon PostgreSQL, serverless)
// ============================================================
// Connection uses PgBouncer pooling for serverless functions
// (Vercel/Render) plus a direct URL for migrations.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

enum PaymentProvider {
  STRIPE
  MOMO
  FLUTTERWAVE
  IREMBOPAY
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ContentType {
  HERO_VIDEO
  BANNER_IMAGE
  THUMBNAIL
  PAGE_COPY
  ANNOUNCEMENT
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  role         Role      @default(USER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  payments  Payment[]
  feedbacks Feedback[]
  cmsEdits  ContentCMS[] @relation("EditedBy")

  @@map("users")
}

// Every editable piece of the site (hero video, banners, thumbnails,
// page copy, announcements) lives here. `localizedFields` stores the
// EN/RW pair as JSONB, e.g. { "en": { "title": "..." }, "rw": { "title": "..." } }
model ContentCMS {
  id              String      @id @default(uuid())
  key             String      @unique // e.g. "hero.video", "home.title", "announcement.banner"
  type            ContentType
  mediaUrl        String?     @map("media_url") // video/image asset URL (CDN/Blob)
  posterUrl       String?     @map("poster_url") // fallback poster image for video
  localizedFields Json        @map("localized_fields") // { en: {...}, rw: {...} }
  isPublished     Boolean     @default(true) @map("is_published")
  updatedBy       String?     @map("updated_by")
  editor          User?       @relation("EditedBy", fields: [updatedBy], references: [id])
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([type])
  @@map("content_cms")
}

model Payment {
  id              String          @id @default(uuid())
  userId          String?         @map("user_id")
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider        PaymentProvider
  providerRef     String          @unique @map("provider_ref") // Stripe/MoMo/Flutterwave transaction id
  amountCents     Int             @map("amount_cents")
  currency        String          @default("RWF")
  status          PaymentStatus   @default(PENDING)
  description     String?
  metadata        Json?
  webhookVerified Boolean         @default(false) @map("webhook_verified")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("payments")
}

model Feedback {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  authorName String   @map("author_name") // allows anonymous/guest feedback
  rating     Int // 1-5
  comment    String
  isApproved Boolean  @default(false) @map("is_approved")
  isHidden   Boolean  @default(false) @map("is_hidden")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isApproved, isHidden])
  @@map("feedback")
}
